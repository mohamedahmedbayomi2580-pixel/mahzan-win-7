{
  "name": "makhzan-owlad-shalba-windows",
  "version": "1.0.0",
  "private": true,
  "description": "مخزن ولاد شلبه - Windows Desktop App",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.owladshalba.makhzan.windows",
    "productName": "مخزن ولاد شلبه",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/main.cjs",
      "app/preload.cjs",
      "app/app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "Makhzan-Owlad-Shalba-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
